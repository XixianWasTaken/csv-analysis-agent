# Full request URL. Secrets are read only from the named host environment variable.
MODEL_PROTOCOL=anthropic
MODEL_ENDPOINT=https://maas-api.cn-huabei-1.xf-yun.com/anthropic/v1/messages
MODEL_NAME=spark-x2.6
MODEL_API_KEY_ENV=SPARK_API_KEY
SPARK_API_KEY=
# Leave empty to use the provider default (Spark currently documents temperature=1).
MODEL_TEMPERATURE=
MODEL_TIMEOUT_SECONDS=90
MODEL_MAX_TOKENS=4096
# Anthropic Messages only. false omits the control unless MODEL_THINKING is set.
MODEL_DISABLE_THINKING=true
# Explicit enabled/adaptive; leave empty for omission. Requires DISABLE_THINKING=false.
MODEL_THINKING=
# structured: validated JSON text, works without native function calling.
# tools: native tools; enable only after checking the configured service.
MODEL_INSTRUCTION_MODE=structured
EXECUTION_IMAGE=csv-agent-python:0.1
EXECUTION_TIMEOUT_SECONDS=20
EXECUTION_MEMORY_MB=512
EXECUTION_CPUS=1
EXECUTION_PIDS=64
EXECUTION_OUTPUT_BYTES=1048576
INPUT_MAX_BYTES=10485760
# Task-wide budgets; execution timeouts and runtime failures stop immediately.
MAX_EXECUTIONS=12
MAX_FORMAT_REPAIRS=1
MAX_MODEL_RETRIES=0
# Independent request cap; includes inspection, candidates, submission and retries.
MAX_MODEL_CALLS=16
TASK_TIMEOUT_SECONDS=1200
